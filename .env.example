# ==============================================================================
# Hardware Stock Monitoring & Branch Requisition System - Environment Variables
# ==============================================================================
# Copy this file to .env for local testing or enter these in Render Environment Settings.

# Server Port (Render provides this automatically in production)
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# TiDB Cloud Serverless (MySQL Compatible) Configuration
# Obtain these from your TiDB Cloud Console -> Connect -> Connect with General Client
# ------------------------------------------------------------------------------
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_username
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=hardware_inventory

# (Alternative) Single Connection String URI:
# DATABASE_URL=mysql://username:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/hardware_inventory

# Note: If TIDB_HOST and DATABASE_URL are not defined, the system automatically
# falls back to local SQLite storage (server/data/inventory.db).
